# MySQL 개별 접속 정보
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=blog_auto_post

# 데이터베이스 연결 URL (직접 지정 시 MYSQL_* 설정보다 우선 적용)
# DATABASE_URL=mysql+pymysql://tistory_app:change-me@127.0.0.1:3306/tistory_automation?charset=utf8mb4

# 티스토리 자동화 설정
TISTORY_EXPECTED_BLOG_NAME=lmh 의 일상
TISTORY_ALLOWED_CATEGORY=홈텍스
AUTO_PUBLISH_ENABLED=true
TISTORY_PRODUCTION_ENABLED=true
TISTORY_PROFILE_PATH=storage/browser_profiles/production
TISTORY_WRITE_URL=https://lmh-life.tistory.com/manage/newpost
TISTORY_SELECTORS_PATH=configs/tistory_selectors.yaml

# 관리자 대시보드 보호 (기본 바인드는 127.0.0.1)
# 허용할 Host 이름(쉼표 구분, 포트 제외). 다른 이름으로 접속하면 400으로 거부된다(DNS 리바인딩 방어).
# DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# 비밀번호를 설정하면 모든 요청에 HTTP Basic 인증을 요구한다. 127.0.0.1이 아닌 주소로 서버를 열려면 반드시 설정해야 한다.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# 발행 잡이 RUNNING에서 이 시간(초) 넘게 멈추면 자동 재실행하지 않고 수동 확인 상태로 돌린다(중복 발행 방지).
# 락을 갱신하는 하트비트가 없어서 정상 발행이 끝나기 전에 만료되지 않도록 600 미만은 허용하지 않는다.
# PUBLISH_LOCK_TTL_SECONDS=1800

# Perplexity LLM 설정
PERPLEXITY_API_KEY=pplx-your_api_key_here
# 모델 이름: Sonar 이름(sonar, sonar-pro, ...), Agent API 프리셋(fast / low / medium / high / xhigh),
# 또는 "provider/model" 형식. Sonar 이름은 공식 마이그레이션 가이드에 따라 프리셋으로 바뀐다(sonar, sonar-pro -> fast).
# 사용 가능한 모델: https://docs.perplexity.ai/docs/agent-api/models
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# 호출 방식: agent(기본, POST /v1/agent) / sonar(2026-09-27에 종료된 레거시 /v1/sonar, 임시 우회용)
# PERPLEXITY_API_MODE=agent
# 웹 검색 지역(ISO 3166-1 alpha-2). 비우면 지정하지 않는다.
# PERPLEXITY_COUNTRY=KR

# 글 생성 설정 (모두 선택. 비워 두면 아래 기본값)
# 글 생성에만 다른 모델을 쓰고 싶을 때. 주제 탐색은 PERPLEXITY_MODEL을 그대로 쓴다.
# 기본(fast)만 실호출로 검증했다(글 한 편에 약 12초, 약 $0.003). low 이상은 더 깊이 조사하지만 호출당 비용·시간이 늘어나고,
# 2026-10-01 실호출에서 low는 HTTP 400이었다(원인 미확인). 쓰기 전에 generate-article --dry-run으로 확인한다.
# ARTICLE_MODEL=
# ARTICLE_TEMPERATURE=0.4
# ARTICLE_MAX_TOKENS=8000
# 규칙 위반(분량 부족, 제한 표현, 근거 없는 제목 숫자 등)이 있을 때 고쳐 쓰도록 다시 요청하는 최대 횟수 (0이면 재작성 안 함)
# ARTICLE_MAX_REVISIONS=1
# LLM 호출 1회당 총 대기 상한(초, 재시도 포함). 대시보드의 '생성 중' 멈춤 판정 기준도 이 값에 맞춰 늘어난다.
# ARTICLE_TIMEOUT_SECONDS=120
# 문체·구조 규칙 파일 (페르소나, 구조, 분량, 제한 표현 등을 이 파일에서 읽는다)
# ARTICLE_STYLE_RULES_PATH=configs/tistory_blog_style_rules.yaml
# 글 제목 방향: clickbait(주제 탐색의 어그로·고CTR 지향, 기본) / persona(스타일 규칙 YAML의 차분한 제목 규칙)
# ARTICLE_TITLE_STYLE=clickbait

# 내부 링크(관련 추천 글). 발행기는 비공개로만 올리므로 기본값은 비로그인으로 열리는(공개 전환된) 글만 연결한다.
# INTERNAL_LINKS_REQUIRE_PUBLIC=true
# 본문 끝에 붙일 추천 글 수(0이면 붙이지 않음, 최대 6)
# INTERNAL_LINKS_LIMIT=3
